[adiscon]
name=adiscon
baseurl=https://rpms.adiscon.com/v8-stable/epel-9/$basearch
enabled=1
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-Adiscon

[adiscon-build]
name=adiscon-build
baseurl=https://rpms.adiscon.com/v8-stable-build/epel-9/$basearch
enabled=1
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-Adiscon

[guardtime]
name=KSI
baseurl=http://download.guardtime.com/ksi/rhel/9/$basearch/
enabled=0
gpgcheck=0
repo_gpgcheck=1
gpgkey=http://download.guardtime.com/ksi/GUARDTIME-GPG-KEY
skip_if_unavailable=true
