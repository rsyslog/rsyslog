FROM ubuntu:24.04
ARG LLVM_VERSION=18
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       build-essential clang-${LLVM_VERSION} libclang-rt-${LLVM_VERSION}-dev llvm-${LLVM_VERSION} \
       autoconf autoconf-archive automake libtool libtool-bin \
       pkg-config flex bison python3-docutils \
       libgnutls28-dev libestr-dev libfastjson-dev zlib1g-dev \
       libgcrypt20-dev librelp-dev uuid-dev libyaml-dev \
       libcurl4-gnutls-dev libprotobuf-c-dev protobuf-c-compiler libsnappy-dev \
       iproute2 gdb \
    && rm -rf /var/lib/apt/lists/*
